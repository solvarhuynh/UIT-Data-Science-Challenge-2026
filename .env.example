# Copy this file to .env for Docker Compose. Values below are safe local
# defaults; no model weights or private data are bundled into the image.

COMPOSE_PROJECT_NAME=udsc2026

# Backend image/build
PYTHON_VERSION=3.11.9-slim-bookworm
APP_UID=10001
APP_GID=10001
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
BACKEND_EXTRAS=llm,rerank,retrieval
BACKEND_IMAGE=hcmute-shipcode/udsc2026-backend:local
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
UDSC2026_CONFIG_PATH=/app/configs/base.yaml
LOG_LEVEL=info

# Host paths mounted into the backend container. Keep model checkpoints and
# generated corpora outside the Docker image.
MODELS_DIR=./models
PROCESSED_DATA_DIR=./data/processed
VECTOR_STORE_DIR=./data/vector_store
MODEL_EMBEDDER_PATH=/app/models/hcmute-embedding-v2
MODEL_LLM_PATH=/app/models/qwen3-legal
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=/app/models/reranker

# Internal Compose URLs. Use localhost only when running Python outside Docker.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_chunks
REDIS_URL=redis://redis:6379/0
VECTOR_DB_TYPE=qdrant
FAISS_INDEX_PATH=/app/data/vector_store/faiss
FAISS_COLLECTION_NAME=legal_chunks
BM25_INDEX_PATH=/app/data/vector_store/bm25/index.json
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_HTTP_PORT=6333
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6380

# Runtime tuning
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=256
EMBEDDING_NORMALIZE_EMBEDDINGS=true
LLM_BACKEND=transformers
LLM_DEVICE=cpu
LLM_DTYPE=float32
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.05
LLM_STREAM=false
LLM_TIMEOUT_SECONDS=60
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_TOP_N=10
RERANKER_LOCAL_FILES_ONLY=true
RERANKER_USE_FP16=false

# Evaluation/submission artifacts are stored in a named Docker volume by
# default. SUBMISSION_PATH is retained only for the legacy generic CSV adapter.
# Both official tasks use isolated one-member ZIP outputs.
SUBMISSION_PATH=/app/output/submission.csv
LEGAL_IR_SUBMISSION_PATH=/app/output/task1/submission.zip
LEGAL_QA_SUBMISSION_PATH=/app/output/task2/submission.zip

# Reproducible service images
QDRANT_IMAGE=qdrant/qdrant:v1.10.1
QDRANT_PROBE_IMAGE=alpine:3.20
REDIS_IMAGE=redis:7.2.14-alpine
QDRANT_HEALTH_RETRIES=30
QDRANT_HEALTH_INTERVAL_SECONDS=1

# Bounded Docker log files
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

